#!/bin/bash
#
# Pre-commit hook: stage the commit's STRUCTURE.json, built from what is
# staged (never from unstaged edits or untracked files). The working copy of
# .frame/STRUCTURE.json is left as it is. Never blocks the commit.
#

node scripts/update-structure.js --staged || true

# Freshness report — warn-only, never blocks the commit
node scripts/check-freshness.js || true

exit 0
